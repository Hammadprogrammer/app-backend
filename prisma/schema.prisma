// HIFATZAT Emergency System — NeonDB PostgreSQL schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  phone     String    @unique
  email     String?   @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contacts  Contact[]
  alerts    Alert[]

  @@map("users")
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  phone     String
  relation  String?
  userId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@map("contacts")
}

enum AlertStatus {
  PENDING
  SENT
  PARTIAL
  FAILED
}

model Alert {
  id        String      @id @default(uuid())
  userId    String
  latitude  Float?
  longitude Float?
  message   String?
  status    AlertStatus @default(PENDING)
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("alerts")
}
